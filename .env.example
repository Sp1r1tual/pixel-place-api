# ============================================================
# SERVER
# ============================================================
PORT=5000
# Number of reverse proxies in front of the API (usually 1 in production)
TRUST_PROXY_HOPS=0

# ============================================================
# URLS
# ============================================================
API_URL=http://localhost:5000
CLIENT_URL=http://localhost:5173
MAIL_SERVICE_URL=http://localhost:10000
# Must match MAIL_API_SECRET in pixel-place-mail-api. Generate with: openssl rand -hex 32
MAIL_API_SECRET=<shared_secret>

# ============================================================
# SUPABASE
# ============================================================
# Get credentials at: https://supabase.com/dashboard/project/<project>/settings/api
SUPABASE_URL=https://<project_id>.supabase.co
# Server-side only: the service_role key bypasses row level security
SUPABASE_SERVICE_ROLE_KEY=<your_service_role_key>

# ============================================================
# JWT
# ============================================================
# Generate strong secrets with: openssl rand -hex 64
JWT_ACCESS_SECRET=<your_access_secret>
JWT_REFRESH_SECRET=<your_refresh_secret>

# ============================================================
# CLOUDINARY (File Storage)
# ============================================================
# Get credentials at: https://console.cloudinary.com
CLOUDINARY_CLOUD_NAME=<cloud_name>
CLOUDINARY_API_KEY=<api_key>
CLOUDINARY_API_SECRET=<api_secret>
